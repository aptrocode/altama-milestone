{
  "name": "altama-interactive-milestone",
  "type": "module",
  "version": "1.0.0",
  "description": "Interactive six-column fullscreen wall for a 2304 x 1344 LED installation.",
  "author": "Adityawarman Dewa Putra",
  "license": "MIT",
  "keywords": [
    "nuxt",
    "kiosk",
    "interactive-installation",
    "lidar"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "bun scripts/dev.ts",
    "dev:web": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "nuxt typecheck && tsc -p sensor-service/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:check": "bun scripts/check-assets.ts",
    "sensor:service": "bun sensor-service/main.ts",
    "sensor:sim": "bun sensor-service/simulate.ts",
    "osc:service": "bun sensor-service/main.ts",
    "osc:send": "bun scripts/send-osc.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
