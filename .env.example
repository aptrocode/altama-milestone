# Build-time public configuration for the static kiosk bundle.
NUXT_PUBLIC_SENSOR_ENABLED=false
NUXT_PUBLIC_SENSOR_WS_URL=ws://127.0.0.1:8787

# Server-only password for /dashboard (empty = dashboard open).
NUXT_DASHBOARD_PASSWORD=

# Settings sync: SQLite file behind /api/settings (server).
NUXT_SETTINGS_DB=.data/altama.sqlite
# Follow another server's settings, e.g. the VPS from the event PC (empty = this server).
NUXT_PUBLIC_SETTINGS_SYNC_URL=
